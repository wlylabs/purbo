{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["chrome-devtools", "playwright"],
  "permissions": {
    "allow": [
      "mcp__chrome-devtools",
      "mcp__playwright",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm start:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run screenshots:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
