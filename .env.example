# ---------------------------------------------------------------------------
# Privy — authentication (required)
#
# Create an app at https://dashboard.privy.io, then copy both values here.
# The app id is public by design; the secret must never reach the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional. Pin the token verification key to skip a network round-trip on
# every authenticated request. Found under Settings in the Privy dashboard.
PRIVY_VERIFICATION_KEY=

# ---------------------------------------------------------------------------
# Storage — encrypted vault blobs (required in production)
#
# Any Upstash-compatible Redis REST endpoint. On Vercel, adding a Redis or
# Upstash integration populates KV_REST_API_URL / KV_REST_API_TOKEN, which
# are read as fallbacks, so either pair works.
#
# This store only ever holds ciphertext: the wrapped root key and AES-256-GCM
# sealed entries. Nothing here is readable without the user's passphrase or
# recovery phrase.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
